    "@fontsource/barlow-condensed": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "fake-indexeddb": "^6.2.8",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
